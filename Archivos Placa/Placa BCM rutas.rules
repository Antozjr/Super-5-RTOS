
(rules PCB DSN para freerouting.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
    (clearance 200.0 (type Power,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-Power,Default" "Via[0-1]_600:300_um" Power,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    Power,Default "Via[0-1]_600:300_um-Power,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    GND /COM2 /COIL2 /NO2 "unconnected-(K2-Pad4)" /PA3 /B1 "/SPI_CS"
    "/SPI_MISO" "/SPI_MOSI" "/SPI_SCK" "/SPI_INT" /PB5 /B5 /COM1 /NO1
    /COIL5 "/TERM_A" /CANL /COM6 /COIL6 /NO6 "unconnected-(K6-Pad4)" /PA5
    /PA10 /LED7 /PA1 "/CIN_FOGR" /LED5 "/VBAT_IN" "/VBAT_FUSED" /COM4
    /COIL4 /NO4 "unconnected-(K4-Pad4)" "/CIN_DEL" /LED3 /LED1 /PA4 /COM5
    /NO5 /CANH /PA8 /PA9 /PB10 "/VBAT_PROT" /GATE "/CIN_HORN"
    /PB1 /B3 /PA2 /B6 /PA6 /PB6 /PB7 /B4
    /COIL1 "unconnected-(J18-Pin_1-Pad1)" "unconnected-(J18-Pin_2-Pad2)" "unconnected-(J18-Pin_3-Pad3)" "unconnected-(J18-Pin_4-Pad4)" "unconnected-(J18-Pin_5-Pad5)" "unconnected-(J18-Pin_6-Pad6)" "unconnected-(J18-Pin_7-Pad7)"
    "unconnected-(J18-Pin_8-Pad8)" "unconnected-(J18-Pin_9-Pad9)" "unconnected-(J18-Pin_10-Pad10)" "unconnected-(J18-Pin_11-Pad11)" "unconnected-(J18-Pin_12-Pad12)" "unconnected-(J18-Pin_13-Pad13)" /LED4 /PA7
    "/CIN_POS" "/CIN_FOGF" "/CIN_IGN" "/CIN_SPARE" /LED2 "unconnected-(K5-Pad4)" /PB0 /B2
    "unconnected-(K1-Pad4)" /PB4 /LED6 /COIL3 "unconnected-(J4-Pin_4-Pad4)" "unconnected-(J4-Pin_5-Pad5)" "unconnected-(J4-Pin_16-Pad16)" "unconnected-(J4-Pin_17-Pad17)"
    "unconnected-(J4-Pin_18-Pad18)" "unconnected-(J4-Pin_19-Pad19)" "unconnected-(J3-Pin_1-Pad1)" "unconnected-(J3-Pin_2-Pad2)" "unconnected-(J3-Pin_3-Pad3)" "unconnected-(J3-Pin_4-Pad4)" "unconnected-(J3-Pin_8-Pad8)" "unconnected-(J3-Pin_9-Pad9)"
    "unconnected-(J3-Pin_10-Pad10)" "unconnected-(J3-Pin_11-Pad11)" /PB8 /PB9 /COM3 /NO3 "unconnected-(K3-Pad4)" "unconnected-(J17-Pin_1-Pad1)"
    "unconnected-(J17-Pin_3-Pad3)" "unconnected-(J17-Pin_4-Pad4)" "unconnected-(J17-Pin_6-Pad6)" "unconnected-(J17-Pin_7-Pad7)" "unconnected-(J17-Pin_11-Pad11)" "unconnected-(J17-Pin_12-Pad12)" "unconnected-(J17-Pin_13-Pad13)" "unconnected-(J17-Pin_14-Pad14)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class Power,Default
    +5V +3V3
    (clearance_class Power,Default)
    (via_rule Power,Default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)